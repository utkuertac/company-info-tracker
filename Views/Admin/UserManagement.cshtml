@model List<CompanyInfoTracker.Models.ApplicationUser>

@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    int currentUserPage = ViewBag.CurrentUserPage ?? 1;
    int totalUserPages = ViewBag.TotalUserPages ?? 1;
}


<h2 class="mb-4 text-center">Kullanıcı Yönetimi</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success text-center">@TempData["Message"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger text-center">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <a asp-controller="Account" asp-action="Register" class="btn btn-add">
        ➕ Yeni Kullanıcı Ekle
    </a>

    <div class="btn-group" role="group">
        <a class="btn btn-outline-secondary @(currentUserPage <= 1 ? "disabled" : "")"
           asp-action="UserManagement" asp-route-userPage="@(currentUserPage - 1)" title="Önceki sayfa">◀</a>
        <span class="btn btn-outline-dark disabled">Sayfa @currentUserPage / @totalUserPages</span>
        <a class="btn btn-outline-secondary @(currentUserPage >= totalUserPages ? "disabled" : "")"
           asp-action="UserManagement" asp-route-userPage="@(currentUserPage + 1)" title="Sonraki sayfa">▶</a>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table custom-table table-hover text-center">
            <thead class="table-secondary">
                <tr>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Kullanıcı Adı</th>
                    <th>E-posta</th>
                    <th>Telefon</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var user in Model)
            {
                <tr>
                    <td>@if (string.IsNullOrWhiteSpace(user.FirstName)) { <span class="veri-yok">-</span> } else { @user.FirstName }</td>
                    <td>@if (string.IsNullOrWhiteSpace(user.LastName)) { <span class="veri-yok">-</span> } else { @user.LastName }</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>@user.PhoneNumber</td>
                    <td>
                        <form asp-action="DeleteUser" method="post" data-confirm="@($"'{user.UserName}' kullanıcısı silinsin mi?")">
                            <input type="hidden" name="userId" value="@user.Id" />
                            <button type="submit" class="btn btn-danger btn-sm btn-icon" title="Kullanıcıyı sil">🗑️ SİL</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning text-center">
        Şu anda kayıtlı kullanıcı bulunmamaktadır.
    </div>
}
