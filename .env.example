# Yerel geliştirme ayarları.
# Bu dosyayı elle doldurmak yerine şunu çalıştırın:  ./scripts/setup-env.sh
# (rastgele, güçlü şifrelerle .env dosyası oluşturur; .env git'e eklenmez)

# docker-compose'daki SQL Server'ın "sa" şifresi; uygulama da bağlanırken bunu kullanır.
# En az 8 karakter; büyük harf, küçük harf, rakam ve sembol içermeli.
MSSQL_SA_PASSWORD=CHANGE_ME

# İlk açılışta oluşturulan "admin" ve "kullanici" hesaplarının şifreleri
SeedUsers__AdminPassword=CHANGE_ME
SeedUsers__UserPassword=CHANGE_ME
